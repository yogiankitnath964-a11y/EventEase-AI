# EventEase AI Environment Configuration
# Copy this file to .env and adjust as needed.

# Backend Port
PORT=3001

# Google Gemini API Key (Optional)
# If provided, EventEase AI queries Google Gemini Generative AI for customized blueprints and ideas.
# If omitted, EventEase AI automatically runs in high-fidelity Deterministic AI Demo Mode.
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Model selection (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Frontend Client Origin (for CORS in production)
CLIENT_URL=http://localhost:5173

